%% poisson equation solver in 2D
%% V(x=0)=0, V(x=1)=1; dirichlet boundary (lext and right edge)
%% dV/dn = 0; neumann boundary for y-axis (upper and lower edge)
%% uniform spacing
clc
clear all;
close all;
%--Define the 2D mesh
loop=1;
Nx=40; Ny=40;
xa=0; xb=1; ya=0; yb=1;
dx=(xb-xa)/(Nx-1);
dy=(yb-ya)/(Ny-1);
M=400; % maximum iteration value
%% Initialize V-matrix and f-matrix
%% (i,j)=potential inside the 2-D box
%% f(i,j)=charge density inside the 2-D box
%% i is along X-axis and j is along Y-axis
V(1:Nx,1:Ny)=0.0;
f(1:Nx,1:Ny)=0.0;
for i=1:Nx, 
for j=1:Ny, 
f(i,j)=20*cos(3*pi*(xa+(i-1)*dx))*sin(2*pi*(ya+(j-1)*dy)); 
end 
end

% Boundary conditions
V(1,:)=0; 
V(Nx,:)=1; %% Dirichlet in x
g=0; %% Neumann in y 

w=cos(pi/Nx)+cos(pi/Ny); % Converging Term
Ncount=0;
loop=1;
while loop==1;
   Rmin=0; 
j=1;
for i=2:Nx-1
   Residue=w.*(0.25.*(V(i-1,j)+V(i+1,j)+2*V(i,j+1)+2*g+f(i,j))-V(i,j));
   Rmin=Rmin+abs(Residue);
   V(i,j)=V(i,j)+Residue;
end
for j=2:Ny-1
for i=2:Nx-1
   Residue=w.*(0.25.*(V(i-1,j)+V(i+1,j)+V(i,j-1)+V(i,j+1)+f(i,j))-V(i,j));
   Rmin=Rmin+abs(Residue);
   V(i,j)=V(i,j)+Residue;
end
end
j=Ny;
for i=2:Nx-1
   Residue=w.*(0.25.*(V(i-1,j)+V(i+1,j)+2*V(i,j-1)+2*g+f(i,j))-V(i,j));
   Rmin=Rmin+abs(Residue);
   V(i,j)=V(i,j)+Residue;
end
Rmin=Rmin/(Nx*Ny); % Average Residue per grid point
if(Rmin>=0.00001)
    Ncount=Ncount+1;
    if(Ncount>M)
        loop=0;
        disp(['solution doesnt converge in ',num2str(M),' iter'])
    end
else
    loop=0;
    disp(['solution converges in ',num2str(Ncount) ,' iteration'])
end
end
%------------------------------------------------------------------------
% Plot the result
%------------------------------------------------------------------------
 X=xa:dx:xb;%1:Nx;
 Y=ya:dy:yb; %1:Ny;
 mesh(X,Y,V','linewidth',2)
 h=gca; 
get(h,'FontSize'); 
set(h,'FontSize',12);
colorbar('location','eastoutside','fontsize',12);
%axis([1 Nx 1 Ny])
xlabel('X','fontSize',12);
ylabel('Y','fontSize',12);
title('Electric Potential Distribution, V(X,Y)','fontsize',12);
fh = figure(1);
set(fh, 'color', 'white'); 
